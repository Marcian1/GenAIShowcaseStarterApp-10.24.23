mdl 1;

drop microflow AWSBedrockImplementation.ACT_TicketList_CreateChunks_StoreInVectorDB;
create or modify microflow AWSBedrockImplementation.ACT_TicketList_CreateChunks_StoreInVectorDB ()
folder 'Ticket'
begin
  -- WARNING: the merge at (507, 99) is not represented in this description - it joins no decision and no error handler. `create or modify` from this MDL leaves it in place, but anything that rebuilds the flow from it (`create or replace`, an mdl 0 fallback) removes it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  @start(-702, 230)
  @position(-562, 230)
  @curve(from: (30, 0), to: (-15, 0))
  $Config = call microflow AWSBedrockImplementation.DS_Config();
  retrieve $DatabaseConfiguration from $Config/AWSBedrockImplementation.Config_DatabaseConfiguration;
  @position(-387, 230)
  @anchor(true: (from: right), false: (from: bottom))
  @curve(from: (15, 0), to: (-30, 0))
  @caption 'exists?'
  if $DatabaseConfiguration != empty then
    @position(-212, 230)
    @curve(from: (30, 0), to: (-30, 0))
    $PgVectorKnowledgeBase = call microflow PgVectorKnowledgeBase.PgVectorKnowledgeBase_GetOrCreate(DatabaseConfiguration = $DatabaseConfiguration, KnowledgeBaseName = 'KnowledgeBase');
    @position(-23, 230)
    call microflow PgVectorKnowledgeBase.KnowledgeBase_Delete(DeployedKnowledgeBase = $PgVectorKnowledgeBase);
    @position(167, 230)
    @curve(from: (30, 0), to: (-30, 0))
    declare $Offset Integer = 0;
    @position(357, 230)
    @curve(from: (30, 0), to: (-15, 0))
    @annotation(text: '96 because of a limit mentioned in the Cohere V4 documentation on amazon website', position: (357, 45), size: (240, 80))
    declare $Amount Integer = 96;
    while true
    begin
      @position(657, 230)
      @curve(from: (30, 0), to: (-30, 0))
      retrieve $TicketList from AWSBedrockImplementation.Ticket
    sort by TicketId asc
    limit $Amount
    offset $Offset;
      @position(847, 230)
      @curve(from: (30, 0), to: (-15, 0))
      $Count = count $TicketList;
      @position(1022, 230)
      @anchor(true: (from: right), false: (from: bottom))
      @curve(from: (15, 0), to: (-30, 0))
      @caption 'Count > 0?'
      if $Count > 0 then
        @position(1192, 230)
        @anchor(from: top)
        $isSuccess = call microflow AWSBedrockImplementation.SUB_BatchTicketList_CreateChunks_InsertInVectorDB(TicketList = $TicketList, PgVectorKnowledgeBase = $PgVectorKnowledgeBase);
        @position(1192, 99)
        @anchor(from: left, to: bottom)
        @curve(from: (-30, 0), to: (15, 0))
        set $Offset = $Offset + $Amount;
      else
        @position(1022, 334)
        @anchor(to: top)
        return;
      end if;
    end while;
  else
    @position(-387, 360)
    @anchor(from: bottom, to: top)
    @curve(from: (0, 30), to: (0, -30))
    show message 'Database configuration not found!' type Error blocking;
    @position(-387, 490)
    @anchor(from: bottom, to: top)
    log error node getCaption(AWSBedrockImplementation.ENUM_LogNode.LogNode) 'Database configuration not found! 
';
    @position(-387, 600)
    @anchor(to: top)
    return;
  end if;
end;

grant execute on microflow AWSBedrockImplementation.ACT_TicketList_CreateChunks_StoreInVectorDB to AWSBedrockImplementation.Admin;

drop microflow AWSBedrockImplementation.DS_TicketChunkList;
create or modify microflow AWSBedrockImplementation.DS_TicketChunkList ()
returns List of AWSBedrockImplementation.TicketChunk as $TicketChunkList
folder 'TicketChunk'
begin
  @start(-50, 200)
  @position(90, 200)
  @curve(from: (30, 0), to: (-15, 0))
  $Config = call microflow AWSBedrockImplementation.DS_Config();
  retrieve $DatabaseConfiguration from $Config/AWSBedrockImplementation.Config_DatabaseConfiguration;
  @position(265, 200)
  @anchor(true: (from: right), false: (from: bottom))
  @caption 'exists?'
  if $DatabaseConfiguration != empty then
    @position(455, 200)
    $PgVectorKnowledgeBase = call microflow PgVectorKnowledgeBase.PgVectorKnowledgeBase_GetOrCreate(DatabaseConfiguration = $DatabaseConfiguration, KnowledgeBaseName = 'KnowledgeBase');
    @position(645, 200)
    $TicketChunks = call java action PgVectorKnowledgeBase.KnowledgeBaseChunkList_Retrieve_SetAssociation(DeployedKnowledgeBase = $PgVectorKnowledgeBase, TargetChunk = 'AWSBedrockImplementation.TicketChunk', MetadataCollection = empty, MaxNumberOfResults = empty, Offset = empty);
    @position(1015, 200)
    return $TicketChunks;
  else
    @position(265, 330)
    @anchor(from: bottom, to: top)
    @curve(from: (0, 30), to: (0, -30))
    show message 'Database configuration not found!' type Error blocking;
    @position(265, 460)
    @anchor(from: bottom, to: top)
    log error node getCaption(AWSBedrockImplementation.ENUM_LogNode.LogNode) 'Database configuration not found! 
';
    @position(265, 570)
    @anchor(to: top)
    return empty;
  end if;
end;

grant execute on microflow AWSBedrockImplementation.DS_TicketChunkList to AWSBedrockImplementation.Admin;

