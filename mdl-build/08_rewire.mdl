drop microflow AWSBedrockImplementation.ACT_PageHelper_PromptRequest_Send;
create or modify microflow AWSBedrockImplementation.ACT_PageHelper_PromptRequest_Send (
  @position(-856, 0)
  $PageHelper: AWSBedrockImplementation.PageHelper
)
folder 'Ticket'
begin
  @start(-856, 200)
  @position(-725, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $Config = call microflow AWSBedrockImplementation.DS_Config();
  @position(-510, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $NewAnthropicRequest = create AWSBedrockImplementation.AnthropicRequest (Anthropic_version = 'bedrock-2023-05-31', Max_tokens = $Config/AWSBedrockImplementation.Config_ChatModel/MaxTokens, System = 'system message');
  @position(-315, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $NewThinking = create AWSBedrockImplementation.Thinking (_type = 'adaptive', Thinking_AnthropicRequest = $NewAnthropicRequest);
  @position(-125, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $NewOutput_config = create AWSBedrockImplementation.Output_config (Effort = getKey($Config/AWSBedrockImplementation.Config_ChatModel/Effort), Output_config_AnthropicRequest = $NewAnthropicRequest);
  @position(65, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $NewMessages = create AWSBedrockImplementation.Messages (Messages_AnthropicRequest = $NewAnthropicRequest);
  @position(255, 200)
  $NewMessage = create AWSBedrockImplementation.Message (Message_Messages = $NewMessages, Role = 'user', Content = $PageHelper/SystemPrompt + 
'
' 
+ $PageHelper/TicketData + 
'
'
+ $PageHelper/UserPrompt);
  @position(445, 200)
  $Request = export to mapping AWSBedrockImplementation.EXM_AnthropicRequest($NewAnthropicRequest) on error without rollback begin
    @position(445, 330)
    @anchor(from: bottom)
    show message 'Export mapping error!

LatestMessage:
{1}

Stacktrace:
{2}' type Error with ({1} = $latestError/Message, {2} = $latestError/Stacktrace) blocking;
    @position(445, 440)
    @anchor(to: top)
    return;
  end error;
  @position(635, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $Response = call java action AWSBedrockImplementation.JA_BedrockInvokeModel(Request = $Request, ModelName = $Config/AWSBedrockImplementation.Config_ChatModel/ModelId, Config = $Config) on error without rollback begin
    @position(635, 330)
