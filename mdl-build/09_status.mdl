mdl 1;

alter entity AWSBedrockImplementation.Config add attribute IsEncryptionReady: Boolean default false;
alter entity AWSBedrockImplementation.Config add attribute IsDatabaseReady: Boolean default false;
alter entity AWSBedrockImplementation.Config add attribute IsChatReady: Boolean default false;
alter entity AWSBedrockImplementation.Config add attribute IsEmbeddingReady: Boolean default false;
alter entity AWSBedrockImplementation.Config add attribute IsTicketsReady: Boolean default false;
alter entity AWSBedrockImplementation.Config add attribute IsKnowledgeBaseReady: Boolean default false;
alter entity AWSBedrockImplementation.Config add attribute ReadyCount: Integer default 0;
grant read *, write * on entity AWSBedrockImplementation.Config to AWSBedrockImplementation.Admin;

drop microflow AWSBedrockImplementation.SUB_Config_RefreshStatus;
drop microflow AWSBedrockImplementation.ACT_Config_Commit;
drop microflow AWSBedrockImplementation.ACT_Config_DatabaseChanged;
drop microflow AWSBedrockImplementation.ACT_Config_Save;
drop microflow AWSBedrockImplementation.ACT_Connection_Test;
drop microflow AWSBedrockImplementation.ACT_PgDatabase_Test;

/** Recomputes everything the setup status shows (counts and ready flags) and saves it on the Config. Call it after anything that changes the setup. */
create or modify microflow AWSBedrockImplementation.SUB_Config_RefreshStatus (
  $Config: AWSBedrockImplementation.Config
)
folder 'Config'
begin
  retrieve $TicketList from AWSBedrockImplementation.Ticket;
  $TicketCount = count $TicketList;
  declare $StaleCount Integer = $TicketCount;
  if $Config/ChunksCreatedAt != empty then
    retrieve $StaleList from AWSBedrockImplementation.Ticket
      where ChangedDateTime > $Config/ChunksCreatedAt or ChangedDateTime = empty;
    $StaleListCount = count $StaleList;
    set $StaleCount = $StaleListCount;
  end if;
  retrieve $ChatModel from $Config/AWSBedrockImplementation.Config_ChatModel;
  retrieve $EmbeddingModel from $Config/AWSBedrockImplementation.Config_EmbeddingModel;
  retrieve $Database from $Config/AWSBedrockImplementation.Config_DatabaseConfiguration;
  declare $KnowledgeBaseReady Boolean = false;
  if $EmbeddingModel != empty then
    if $Config/ChunkCount > 0 and $Config/ChunksModelId = $EmbeddingModel/ModelId and $StaleCount = 0 then
      set $KnowledgeBaseReady = true;
    end if;
  end if;
  declare $EncryptionReady Boolean = @Encryption.EncryptionKey != '';
  declare $DatabaseReady Boolean = $Database != empty and $Config/PgTestOk;
  declare $ChatReady Boolean = $ChatModel != empty;
  declare $EmbeddingReady Boolean = $EmbeddingModel != empty;
  declare $TicketsReady Boolean = $TicketCount > 0;
  declare $ReadyCount Integer = (if $Config/AwsTestOk then 1 else 0) + (if $EncryptionReady then 1 else 0) + (if $DatabaseReady then 1 else 0) + (if $ChatReady then 1 else 0) + (if $EmbeddingReady then 1 else 0) + (if $TicketsReady then 1 else 0) + (if $KnowledgeBaseReady then 1 else 0);
  change $Config (
    TicketCount = $TicketCount,
    StaleTicketCount = $StaleCount,
    IsEncryptionReady = $EncryptionReady,
    IsDatabaseReady = $DatabaseReady,
    IsChatReady = $ChatReady,
    IsEmbeddingReady = $EmbeddingReady,
    IsTicketsReady = $TicketsReady,
    IsKnowledgeBaseReady = $KnowledgeBaseReady,
    ReadyCount = $ReadyCount
  );
  commit $Config refresh;
  return;
end;

/** On change of a model picker: saves the Config and updates the setup status. */
create or modify microflow AWSBedrockImplementation.ACT_Config_Commit (
  $Config: AWSBedrockImplementation.Config
)
folder 'Config'
begin
  call microflow AWSBedrockImplementation.SUB_Config_RefreshStatus(Config = $Config);
  return;
end;

/** On change of the vector database picker: the earlier test no longer applies to the new database. */
create or modify microflow AWSBedrockImplementation.ACT_Config_DatabaseChanged (
  $Config: AWSBedrockImplementation.Config
)
folder 'Config'
begin
  change $Config (PgTestOk = false, PgTestedAt = empty);
  call microflow AWSBedrockImplementation.SUB_Config_RefreshStatus(Config = $Config);
  return;
end;

/** Saves the region and guardrail. The AWS test is reset because the region may have changed. */
create or modify microflow AWSBedrockImplementation.ACT_Config_Save (
  $Config: AWSBedrockImplementation.Config
)
folder 'Config'
begin
  change $Config (AwsTestOk = false, AwsTestResult = empty);
  call microflow AWSBedrockImplementation.SUB_Config_RefreshStatus(Config = $Config);
  show message 'Saved. Click Test connection to check the new settings.' type Information blocking;
  return;
end;

/** Checks the AWS credentials, caller identity and Bedrock access, and stores the result on the Config. */
create or modify microflow AWSBedrockImplementation.ACT_Connection_Test (
  $Config: AWSBedrockImplementation.Config
)
folder 'Config'
begin
  $Result = call java action AWSBedrockImplementation.JA_BedrockTestConnection(RegionName = $Config/BedrockRegion) on error without rollback begin
    change $Config (AwsTestOk = false, AwsTestedAt = [%CurrentDateTime%], AwsTestResult = '- ✗ The test could not run. ' + $latestError/Message);
    call microflow AWSBedrockImplementation.SUB_Config_RefreshStatus(Config = $Config);
    return;
  end error;
  declare $Failed Boolean = contains($Result, 'FAIL:');
  change $Config (AwsTestOk = not($Failed), AwsTestedAt = [%CurrentDateTime%], AwsTestResult = replaceAll(replaceAll($Result, 'OK: ', '- ✓ '), 'FAIL: ', '- ✗ '));
  call microflow AWSBedrockImplementation.SUB_Config_RefreshStatus(Config = $Config);
  return;
end;

/** Tests a pgvector database (connection and vector extension). Records the result when it is the selected database. */
create or modify microflow AWSBedrockImplementation.ACT_PgDatabase_Test (
  $DatabaseConfiguration: PgVectorKnowledgeBase.DatabaseConfiguration
)
folder 'Config'
begin
  $Config = call microflow AWSBedrockImplementation.DS_Config();
  declare $Success Boolean = false;
  declare $Message String = 'Could not connect. Check the JDBC URL, user and password.';
  $Connected = call microflow PgVectorKnowledgeBase.DatabaseConfiguration_TestConnection(DatabaseConfiguration = $DatabaseConfiguration);
  if $Connected then
    set $Message = 'Connected, but the pgvector extension could not be created.';
    $ExtensionReady = call microflow PgVectorKnowledgeBase.DatabaseConfiguration_CreateExtension(DatabaseConfiguration = $DatabaseConfiguration);
    if $ExtensionReady then
      set $Success = true;
      set $Message = 'Connected, and the pgvector extension is available.';
    end if;
  end if;
  retrieve $SelectedDatabase from $Config/AWSBedrockImplementation.Config_DatabaseConfiguration;
  if $SelectedDatabase = $DatabaseConfiguration then
    change $Config (PgTestOk = $Success, PgTestedAt = [%CurrentDateTime%]);
    call microflow AWSBedrockImplementation.SUB_Config_RefreshStatus(Config = $Config);
  end if;
  if $Success then
    show message '{1}' type Information with ({1} = $Message) blocking;
  else
    show message '{1}' type Error with ({1} = $Message) blocking;
  end if;
  return;
end;
